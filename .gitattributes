# src/data/*.json is regenerated by `npm run update-data` (locally and via the
# update-data.yml cron). Never worth merging line-by-line — always keep "our"
# side during a merge/pull instead of conflicting. Requires a one-time local
# setup: `git config merge.ours.driver true` (see AGENTS.md).
src/data/*.json merge=ours
