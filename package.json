{
  "name": "playoffs-picture",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "predev": "node --experimental-strip-types start-sprite.ts",
    "dev": "astro dev",
    "prebuild": "node --experimental-strip-types start-sprite.ts",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --experimental-strip-types --import ./tests/register.ts --test tests/*.test.ts",
    "test:schedule": "node --experimental-strip-types --import ./tests/register.ts tests/season-schedule.browser.ts",
    "test:my-teams": "node --experimental-strip-types --import ./tests/register.ts tests/my-teams.browser.ts",
    "test:modal": "node --experimental-strip-types --import ./tests/register.ts tests/schedule-modal.browser.ts",
    "test:components": "node --experimental-strip-types --import ./tests/register.ts tests/components.browser.ts",
    "update-data": "node --experimental-strip-types scraper/fetch-standings.ts && node --experimental-strip-types scraper/fetch-nfl-data.ts",
    "check": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@vercel/analytics": "^1.6.1",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^5.16.4",
    "puppeteer": "^24.32.1",
    "sass": "^1.95.0",
    "vite-plugin-pwa": "^1.2.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
