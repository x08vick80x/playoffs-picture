{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "dev-dist"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@scraper/*": [
        "./scraper/*"
      ]
    },
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "astro/client",
      "vite-plugin-pwa/client"
    ]
  }
}
