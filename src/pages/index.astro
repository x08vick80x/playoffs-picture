---
import type { Standings as StandingsData, PlayoffPicture, ScheduleData } from "@/types/football.ts";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/organisms/Header/Header.astro";
import Standings from "@/components/organisms/Standings/Standings.astro";
import Matchups from "@/components/organisms/Matchups/Matchups.astro";
import BubbleEliminated from "@/components/organisms/BubbleEliminated/BubbleEliminated.astro";
import MyTeams from "@/components/organisms/MyTeams/MyTeams.astro";
import Footer from "@/components/organisms/Footer/Footer.astro";
import ScheduleModal from "@/components/organisms/ScheduleModal/ScheduleModal.astro";
import PowerRankings from "@/components/organisms/PowerRankings/PowerRankings.astro";
import PageTitle from "@/components/atoms/PageTitle/PageTitle.astro";
import LastUpdated from "@/components/atoms/LastUpdated/LastUpdated.astro";
import Button from "@/components/atoms/Button/Button.astro";
import BackToTop from "@/components/atoms/BackToTop/BackToTop.astro";
import SeasonSchedule from "@/components/organisms/SeasonSchedule/SeasonSchedule.astro";
import { getClinchStatuses, mergeEliminated } from "@/utils/clinch.ts";
import fs from "node:fs";

import path from "node:path";

// Load data using Node fs
const standingsPath = path.resolve("./src/data/standings.json");
const standings: StandingsData = JSON.parse(fs.readFileSync(standingsPath, "utf-8"));

const playoffPicturePath = path.resolve("./src/data/playoff-picture.json");
const playoffPicture: PlayoffPicture = JSON.parse(fs.readFileSync(playoffPicturePath, "utf-8"));

const schedulePath = path.resolve("./src/data/schedule.json");
const schedule: ScheduleData = JSON.parse(fs.readFileSync(schedulePath, "utf-8"));

// Computed from standings; the scraped eliminated list only fills in extra detail.
const clinch = getClinchStatuses(standings);
const eliminated = mergeEliminated(playoffPicture.eliminated, standings, clinch, schedule.teamSchedules);

// Data time from the scraper; the build time says nothing about freshness.
const lastUpdatedIso: string = standings.lastUpdated!;
const lastUpdated = new Date(lastUpdatedIso).toLocaleString("en-US", {
	timeZone: "America/New_York",
	day: "numeric",
	month: "long",
	hour: "2-digit",
	minute: "2-digit",
});
---

<Layout title="NFL Playoff Picture 2026">
	<Header currentWeek={schedule.currentWeek} />
	<main>
		<div class="content-wrapper">
			<PageTitle />
			<LastUpdated date={lastUpdated} iso={lastUpdatedIso} />

			<div id="install-container" class="install-container" hidden>
				<Button id="install-pwa">
					<svg
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
						></path>
						<polyline points="7 10 12 15 17 10"></polyline>
						<line x1="12" y1="15" x2="12" y2="3"></line>
					</svg>
					Install App
				</Button>
				<p class="install-text">
					super lightweight PWA App that can load offline with your
					preference saved, until next app datas update
				</p>
			</div>

			<MyTeams />

			<section id="matchups">
				<Matchups
					afc={standings.AFC}
					nfc={standings.NFC}
					seeds={playoffPicture.seeds}
					currentWeek={schedule.currentWeek}
				/>
			</section>

			<BubbleEliminated
				bubble={playoffPicture.bubble}
				eliminated={eliminated}
				currentWeek={schedule.currentWeek}
			/>

			<section id="schedule">
				<SeasonSchedule
					weeks={schedule.weeks}
				/>
			</section>

			<section id="power-rankings">
				<PowerRankings rankings={playoffPicture.powerRankings || []} />
			</section>

			<section id="standings">
				<Standings afc={standings.AFC} nfc={standings.NFC} clinch={clinch} />
			</section>
		</div>
	</main>
	<ScheduleModal />
	<BackToTop />
	<Footer />
</Layout>

<style lang="scss">
	@use "@/styles/variables" as *;
	html {
		scroll-behavior: smooth;
		scroll-padding-top: $scroll-offset-header; /* Offset for sticky header */
	}

	main {
		min-height: 80vh;
		padding-top: $spacing-20;
	}

	.content-wrapper {
		max-width: 1200px;
		margin: 0 auto;
	}

	.install-container {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin: -$spacing-10 auto 0;
		text-align: center;

		&[hidden] {
			display: none;
		}
	}

	.install-text {
		font-size: 1.4rem;
		color: var(--text-secondary);
		margin-top: $spacing-12;
		max-width: 35rem;
		line-height: 1.4;
	}
</style>
