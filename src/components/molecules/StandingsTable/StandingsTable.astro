---
import Logo from '@/components/atoms/Logo/Logo.astro';

interface Props {
    title: string;
    teams: { team: string; record: string; seed: string; rank?: number }[];
    ranking?: 'division' | 'conference' | 'league';
    clinch?: Record<string, string>;
}

const { title, teams, ranking = 'division', clinch = {} } = Astro.props;
const clinchLabels: Record<string, [string, string]> = {
    division: ['y', 'Clinched division'],
    playoff: ['x', 'Clinched playoff berth'],
    eliminated: ['e', 'Eliminated'],
};
---

<table class="standings-table">
    <caption>{title}</caption>
    <thead>
        <tr><th scope="col">#</th><th scope="col">Team</th><th scope="col">Rec</th></tr>
    </thead>
    <tbody>
        {teams.map((team, index) => (
            <tr data-team={team.team} class:list={['standings-table__row', {
                'standings-table__row--playoff-spot': ranking === 'conference' && Number(team.seed) <= 7,
                'standings-table__row--top-seed': ranking === 'conference' && Number(team.seed) === 1,
            }]}>
                <td class="standings-table__rank"><span class="standings-table__pos">{ranking === 'conference' ? team.seed : ranking === 'league' ? team.rank : index + 1}</span></td>
                <th scope="row">
                    <span class="standings-table__team">
                        <Logo team={team.team} size="md" />
                        <span>{team.team}</span>
                        {clinchLabels[clinch[team.team]] && (
                            <abbr class={`standings-table__clinch standings-table__clinch--${clinch[team.team]}`} title={clinchLabels[clinch[team.team]][1]}>{clinchLabels[clinch[team.team]][0]}</abbr>
                        )}
                        <span class="standings-table__fav" role="img" aria-label="Favorite team">★</span>
                    </span>
                </th>
                <td class="standings-table__record">{team.record.split('-').map((part, i) => (<>{i > 0 && <span class="standings-table__sep">–</span>}<span class:list={['standings-table__num', { 'standings-table__num--wins': i === 0 }]}>{part}</span></>))}</td>
            </tr>
        ))}
    </tbody>
</table>
