---
import { logoSizes } from './Logo.js';
import { getTeamId } from "@/utils/team-mapping.js";

interface Props {
    team: string; // Team name (e.g., "Bills") or ID
    size?: keyof typeof logoSizes; // md=40, lg=55
    className?: string;
}

const { team, size = "md", className = "" } = Astro.props;

const pixelSize = logoSizes[size];
const teamId = getTeamId(team);
---

<svg
    class:list={[
        "team-logo",
        `team-logo--${size}`,
        className,
    ]}
    width={pixelSize}
    height={pixelSize}
    aria-hidden="true"
>
    <use href={`/sprites.svg#${teamId}`}></use>
</svg>
