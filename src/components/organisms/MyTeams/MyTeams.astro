---
import FavoritesSelector from '@/components/molecules/FavoritesSelector/FavoritesSelector.astro';
---

<section id="my-teams-root" class="my-teams" aria-labelledby="mt-title" aria-busy="true">
    <div class="my-teams__header">
        <h2 id="mt-title" class="my-teams__title">My Teams</h2>
        <div class="my-teams__actions">
            <button class="my-teams__action" id="mt-previous" aria-label="Previous favorite team" aria-controls="mt-dashboard" disabled>←</button>
            <button class="my-teams__action" id="mt-next" aria-label="Next favorite team" aria-controls="mt-dashboard" disabled>→</button>
            <button class="my-teams__action" id="btn-edit-teams" aria-label="Edit favorites" disabled>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
            </button>
        </div>
    </div>
    <div class="my-teams__viewport">
        <ul id="mt-dashboard" class="my-teams__carousel" aria-label="Favorite teams" tabindex="0" hidden></ul>
        <div id="mt-loading" class="my-teams__loading" aria-hidden="true">
            {[0, 1].map(() => (
                <div class="my-teams__skeleton">
                    <div class="my-teams__skeleton-row">
                        <span class="my-teams__placeholder my-teams__placeholder--identity"></span>
                        <span class="my-teams__placeholder my-teams__placeholder--probability"></span>
                    </div>
                    <div class="my-teams__skeleton-row my-teams__skeleton-row--footer">
                        <span class="my-teams__placeholder my-teams__placeholder--power"></span>
                        <span class="my-teams__placeholder my-teams__placeholder--opponent"></span>
                    </div>
                </div>
            ))}
        </div>
        <div id="mt-message" class="my-teams__message" hidden>
            <p id="mt-message-text"></p>
            <button id="mt-retry" class="my-teams__retry" hidden>Try again</button>
        </div>
    </div>
    <p id="mt-status" class="my-teams__status" role="status">Loading favorite teams…</p>
    <FavoritesSelector />
</section>

<script>
    const root = document.getElementById('my-teams-root')!;
    const media = matchMedia('(display-mode: standalone)');
    const retry = document.getElementById('mt-retry')!;
    const message = document.getElementById('mt-message')!;
    const skeleton = document.getElementById('mt-loading')!;
    const status = document.getElementById('mt-status')!;
    let initialized = false;
    let loading = false;

    async function activate() {
        const standalone = media.matches || (navigator as Navigator & { standalone?: boolean }).standalone === true;
        document.documentElement.dataset.standalone = String(standalone);
        if (!standalone || initialized || loading) return;
        loading = true;
        root.setAttribute('aria-busy', 'true');
        skeleton.hidden = false;
        message.hidden = true;
        status.textContent = 'Loading favorite teams…';
        try {
            const { initMyTeams } = await import('./my-teams.ts');
            await initMyTeams();
            initialized = true;
        } catch {
            skeleton.hidden = true;
            message.hidden = false;
            retry.hidden = false;
            document.getElementById('mt-message-text')!.textContent = 'Favorite teams could not be loaded.';
            status.textContent = 'Favorite teams could not be loaded. Try again.';
        } finally {
            loading = false;
            root.setAttribute('aria-busy', 'false');
        }
    }

    retry.addEventListener('click', activate);
    media.addEventListener('change', activate);
    window.addEventListener('pageshow', activate);
    // Installing from a browser tab does not make that tab standalone.
    void activate();
</script>
