---
import type { PlayoffTeam } from "@/types/football.ts";
import { PLAYOFF_PICTURE_MIN_WEEK as MIN_WEEK } from "@scraper/config.ts";
import SectionTitle from "@/components/atoms/SectionTitle/SectionTitle.astro";
import ConferenceHeader from "@/components/atoms/ConferenceHeader/ConferenceHeader.astro";
import UnavailableNotice from "@/components/atoms/UnavailableNotice/UnavailableNotice.astro";
import BubbleCard from "@/components/molecules/BubbleCard/BubbleCard.astro";

type Team = PlayoffTeam;

interface ConferenceData {
    AFC: Team[];
    NFC: Team[];
}

interface Props {
    bubble: ConferenceData;
    eliminated: ConferenceData;
    currentWeek?: number;
}

const { bubble, eliminated, currentWeek } = Astro.props;

const isAvailable = currentWeek === undefined || currentWeek >= MIN_WEEK;
---

<div class="bubble-eliminated">
    {!isAvailable && <UnavailableNotice until={MIN_WEEK} />}

    {isAvailable && (
    <>
    <!-- Bubble Section -->
    <section id="bubble" class="bubble-eliminated__section">
        <SectionTitle title="On The Bubble" />

        <div class="bubble-eliminated__conferences">
            {
                (["AFC", "NFC"] as const).map((conf) => (
                    <div class="bubble-eliminated__conference">
                        <ConferenceHeader conf={conf} />

                        <div class="bubble-eliminated__teams">
                            {bubble[conf].map((team) => (
                                <BubbleCard team={team} />
                            ))}
                            {bubble[conf].length === 0 && (
                                <div class="bubble-eliminated__empty">
                                    - No teams on the bubble -
                                </div>
                            )}
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- Eliminated Section -->
    <section id="eliminated" class="bubble-eliminated__section">
        <SectionTitle title="Eliminated" />

        <div class="bubble-eliminated__conferences">
            {
                (["AFC", "NFC"] as const).map((conf) => (
                    <div class="bubble-eliminated__conference">
                        <ConferenceHeader conf={conf} />

                        <div class="bubble-eliminated__teams">
                            {eliminated[conf].map((team) => (
                                <BubbleCard team={team} isEliminated={true} />
                            ))}
                            {eliminated[conf].length === 0 && (
                                <div class="bubble-eliminated__empty">
                                    - No teams eliminated -
                                </div>
                            )}
                        </div>
                    </div>
                ))
            }
        </div>
    </section>
    </>
    )}
</div>
