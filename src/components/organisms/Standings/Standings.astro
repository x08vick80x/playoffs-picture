---
import type { StandingTeam } from "@/types/football.ts";
import SectionTitle from '@/components/atoms/SectionTitle/SectionTitle.astro';
import StandingsTable from '@/components/molecules/StandingsTable/StandingsTable.astro';
import { DIVISIONS, getDivisionTeams, rankLeague } from '@/utils/standings.ts';

type Team = StandingTeam;

interface Props {
    afc: Team[];
    nfc: Team[];
    clinch?: Record<string, string>;
}

const { afc, nfc, clinch = {} } = Astro.props;
const conferences = { AFC: afc, NFC: nfc };
const filters = [
    { id: 'divisions', label: 'Divisions' },
    { id: 'afc', label: 'AFC' },
    { id: 'nfc', label: 'NFC' },
    { id: 'league', label: 'NFL' },
    { id: 'mine', label: 'My Teams' },
];
---

<div class="standings" data-standings>
    <SectionTitle title="Standings" />

    <nav class="standings-filters" aria-label="Standings filters">
        {filters.map(({ id, label }) => (
            <a
                href={`#standings-${id}`}
                class="standings-filters__link"
                data-standings-filter={id}
                aria-controls={`standings-${id}`}
                aria-current={id === 'divisions' ? 'true' : undefined}
                hidden={id === 'mine' ? true : undefined}
            >{label}</a>
        ))}
    </nav>

    {Object.values(clinch).some(status => status !== 'alive') && (
        <p class="standings__note">y clinched division · x clinched playoff berth · e eliminated</p>
    )}

    <div id="standings-divisions" class="standings__divisions" data-standings-panel="divisions">
        {DIVISIONS.map(division => (
            <StandingsTable
                title={division.name}
                clinch={clinch}
                teams={getDivisionTeams(conferences[division.conference as keyof typeof conferences], division)}
            />
        ))}
    </div>

    <div id="standings-afc" data-standings-panel="afc" hidden>
        <StandingsTable title="AFC" teams={afc} ranking="conference" clinch={clinch} />
    </div>
    <div id="standings-nfc" data-standings-panel="nfc" hidden>
        <StandingsTable title="NFC" teams={nfc} ranking="conference" clinch={clinch} />
    </div>
    <div id="standings-league" data-standings-panel="league" hidden>
        <p class="standings__note">Sorted by win percentage. Tied teams share the same rank.</p>
        <StandingsTable title="NFL" teams={rankLeague([...afc, ...nfc])} ranking="league" clinch={clinch} />
    </div>
    <div id="standings-mine" data-standings-panel="mine" hidden>
        <p class="standings__note">Your favorite teams, with their NFL rank.</p>
        <div data-standings-mine></div>
    </div>
</div>
