---
import SectionTitle from '@/components/atoms/SectionTitle/SectionTitle.astro';
import StandingsTable from '@/components/molecules/StandingsTable/StandingsTable.astro';
import { DIVISIONS, getDivisionTeams, rankLeague } from '@/utils/standings.js';

interface Team {
    seed: string;
    team: string;
    record: string;
    status: string;
}

interface Props {
    afc: Team[];
    nfc: Team[];
}

const { afc, nfc } = Astro.props;
const conferences = { AFC: afc, NFC: nfc };
const filters = [
    { id: 'divisions', label: 'Divisions' },
    { id: 'afc', label: 'AFC' },
    { id: 'nfc', label: 'NFC' },
    { id: 'league', label: 'NFL' },
];
---

<div class="standings-container" data-standings>
    <SectionTitle title="Standings" />

    <nav class="standings-filters" aria-label="Standings filters">
        {filters.map(({ id, label }) => (
            <a
                href={`#standings-${id}`}
                class="standings-filters__link"
                data-standings-filter={id}
                aria-controls={`standings-${id}`}
                aria-current={id === 'divisions' ? 'true' : undefined}
            >{label}</a>
        ))}
    </nav>

    <div id="standings-divisions" class="standings-divisions" data-standings-panel="divisions">
        {DIVISIONS.map(division => (
            <StandingsTable
                title={division.name}
                teams={getDivisionTeams(conferences[division.conference as keyof typeof conferences], division)}
            />
        ))}
    </div>

    <div id="standings-afc" data-standings-panel="afc" hidden>
        <StandingsTable title="AFC" teams={afc} ranking="conference" />
    </div>
    <div id="standings-nfc" data-standings-panel="nfc" hidden>
        <StandingsTable title="NFC" teams={nfc} ranking="conference" />
    </div>
    <div id="standings-league" data-standings-panel="league" hidden>
        <p class="standings-note">Sorted by win percentage. Tied teams share the same rank.</p>
        <StandingsTable title="NFL" teams={rankLeague([...afc, ...nfc])} ranking="league" />
    </div>
</div>

<script>
    document.querySelectorAll<HTMLElement>('[data-standings]').forEach(container => {
        const links = container.querySelectorAll<HTMLAnchorElement>('[data-standings-filter]');
        const panels = container.querySelectorAll<HTMLElement>('[data-standings-panel]');

        function activate(filter: string) {
            panels.forEach(panel => { panel.hidden = panel.dataset.standingsPanel !== filter; });
            links.forEach(link => {
                if (link.dataset.standingsFilter === filter) link.setAttribute('aria-current', 'true');
                else link.removeAttribute('aria-current');
            });
        }

        function syncHash() {
            const link = Array.from(links).find(link => link.hash === window.location.hash);
            activate(link?.dataset.standingsFilter || 'divisions');
        }

        links.forEach(link => link.addEventListener('click', event => {
            if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
            activate(link.dataset.standingsFilter!);
        }));
        window.addEventListener('hashchange', syncHash);
        syncHash();
    });
</script>
