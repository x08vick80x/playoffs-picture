---
import { PLAYOFF_PICTURE_MIN_WEEK } from "@scraper/config.js";

interface Props {
    currentWeek?: number;
}

const { currentWeek } = Astro.props;
const isPlayoffPictureActive = currentWeek === undefined || currentWeek >= PLAYOFF_PICTURE_MIN_WEEK;
const playoffLinks = [
    { href: "#matchups", label: "Matchups" },
    { href: "#bubble", label: "Bubble" },
    { href: "#eliminated", label: "Eliminated" },
];
---

<header class="header">
    <div class="header__inner">
        <a href="/" class="header-logo" aria-label="NFL Playoff Picture">
            <span class="header-logo__wrapper">
                <span class="header-logo__brand">NFL</span>
                <span class="header-logo__text">PLAYOFF PICTURE</span>
            </span>
        </a>

        <nav class="main-nav">
            <ul class="main-nav__list">
                <li class="main-nav__item">
                    <a href="#schedule" class="main-nav__link">Schedule</a>
                </li>
                {playoffLinks.map(({ href, label }) => (
                    <li class="main-nav__item">
                        <a
                            href={isPlayoffPictureActive ? href : undefined}
                            class="main-nav__link"
                            role={isPlayoffPictureActive ? undefined : "link"}
                            aria-disabled={isPlayoffPictureActive ? undefined : "true"}
                            title={isPlayoffPictureActive ? undefined : `Available from Week ${PLAYOFF_PICTURE_MIN_WEEK}`}
                        >
                            {label}
                        </a>
                    </li>
                ))}
                <li class="main-nav__item">
                    <a href="#power-rankings" class="main-nav__link"
                        >Power Rankings</a>
                </li>
                <li class="main-nav__item">
                    <a href="#standings" class="main-nav__link">Standings</a>
                </li>
            </ul>
        </nav>
    </div>
</header>
