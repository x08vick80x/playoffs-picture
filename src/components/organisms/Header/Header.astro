---
import { PLAYOFF_PICTURE_MIN_WEEK } from "@scraper/config.ts";

interface Props {
    currentWeek?: number;
}

const { currentWeek } = Astro.props;
const isPlayoffPictureActive = currentWeek === undefined || currentWeek >= PLAYOFF_PICTURE_MIN_WEEK;
const playoffLinks = [
    { href: "#matchups", label: "Matchups" },
    { href: "#bubble", label: "Bubble" },
    { href: "#eliminated", label: "Eliminated" },
];
---

<header class="header">
    <div class="header__inner">
        <a href="/" class="header-logo" aria-label="NFL Playoff Picture">
            <span class="header-logo__wrapper">
                <span class="header-logo__brand">NFL</span>
                <span class="header-logo__text">PLAYOFF PICTURE</span>
            </span>
        </a>

        <nav class="main-nav">
            <ul class="main-nav__list">
                {playoffLinks.map(({ href, label }) => (
                    <li class="main-nav__item">
                        <a
                            href={isPlayoffPictureActive ? href : undefined}
                            class="main-nav__link"
                            role={isPlayoffPictureActive ? undefined : "link"}
                            aria-disabled={isPlayoffPictureActive ? undefined : "true"}
                            title={isPlayoffPictureActive ? undefined : `Available from Week ${PLAYOFF_PICTURE_MIN_WEEK}`}
                        >
                            {label}
                        </a>
                    </li>
                ))}
                <li class="main-nav__item">
                    <a href="#schedule" class="main-nav__link">Schedule</a>
                </li>
                <li class="main-nav__item">
                    <a href="#power-rankings" class="main-nav__link"
                        >Power Rankings</a>
                </li>
                <li class="main-nav__item">
                    <a href="#standings" class="main-nav__link">Standings</a>
                </li>
            </ul>
        </nav>

        <button type="button" class="theme-toggle" aria-label="Switch theme">
            <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
            </svg>
            <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"></path>
            </svg>
        </button>
    </div>
</header>
