---
import SectionTitle from '@/components/atoms/SectionTitle/SectionTitle.astro';
import type { Ranking } from '@/types/football.ts';
import RankingCard from '@/components/molecules/RankingCard/RankingCard.astro';

interface Props { rankings: Ranking[]; }
const { rankings } = Astro.props;
---

<section class="power-rankings">
    <SectionTitle title="Power Rankings" />
    <div class="power-rankings__list">
        {rankings?.length ? (
            rankings.map(item => <RankingCard item={item} />)
        ) : (
            <div class="power-rankings__empty">Rankings data unavailable.</div>
        )}
    </div>
</section>
