---
---

<dialog id="schedule-modal" class="modal">
    <div class="modal__content">
        <header class="modal__header">
            <svg id="modal-team-logo" class="modal__logo" width="56" height="56">
                <use href="/sprites.svg#nfl"></use>
            </svg>
            <div class="modal__heading">
                <span class="modal__eyebrow">Remaining schedule</span>
                <h2 id="modal-team-name" class="modal__title">Team Name</h2>
                <span id="modal-games-left" class="modal__count"></span>
            </div>
            <button id="close-modal" class="modal__close-btn" aria-label="Close">&times;</button>
        </header>

        <div class="modal__list" id="schedule-list">
            <!-- Populated via JS -->
        </div>
    </div>
</dialog>

<script>
    import { getTeamId } from "@/utils/team-mapping.js";

    const modal = document.getElementById("schedule-modal") as HTMLDialogElement | null;
    const closeBtn = document.getElementById("close-modal");
    const title = document.getElementById("modal-team-name");
    const logo = document.querySelector<SVGUseElement>("#modal-team-logo use");
    const count = document.getElementById("modal-games-left");
    const list = document.getElementById("schedule-list");

    // One delegated listener serves matchups and bubble/eliminated cards,
    // including clicks on their nested buttons and SVG logos.
    document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;
        const trigger = event.target.closest<HTMLElement>(".team-card-trigger");
        if (!trigger) return;
        window.dispatchEvent(new CustomEvent("open-schedule-modal", {
            detail: {
                teamName: trigger.dataset.team,
                schedule: JSON.parse(trigger.dataset.schedule || "[]"),
            },
        }));
    });

    const escapeHtml = (value: unknown) =>
        String(value ?? "").replace(
            /[&<>"']/g,
            (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!,
        );

    // "Sunday, November 8" -> { day: "Sun", date: "Nov 8" }
    const splitDate = (value?: string) => {
        const [weekday, rest] = (value || "").split(", ");
        if (!rest) return null;
        const [month, dayNumber] = rest.split(" ");
        return { day: weekday.slice(0, 3), date: `${month.slice(0, 3)} ${dayNumber}` };
    };

    window.addEventListener("open-schedule-modal", (e) => {
        const { teamName, schedule } = (e as CustomEvent).detail;

        if (title) title.textContent = teamName;
        if (logo) logo.setAttribute("href", `/sprites.svg#${getTeamId(teamName)}`);
        if (count) {
            count.textContent = `${schedule.length} ${schedule.length === 1 ? "game" : "games"} left`;
        }

        if (list) {
            list.innerHTML = schedule
                .map((game, index) => {
                    const parts = splitDate(game.date);
                    const when = parts
                        ? `<span class="game-item__day">${escapeHtml(parts.day)}</span><span class="game-item__date">${escapeHtml(parts.date)}</span>`
                        : `<span class="game-item__day">Week</span><span class="game-item__date">${escapeHtml(String(game.week).replace(/^REG/, ""))}</span>`;
                    const isHome = game.location === "vs";

                    return `
                <div class="game-item${index === 0 ? " game-item--next" : ""}">
                    <div class="game-item__when">${when}</div>
                    <svg class="game-item__logo" width="40" height="40">
                        <use href="/sprites.svg#${escapeHtml(getTeamId(game.opponent))}"></use>
                    </svg>
                    <div class="game-item__info">
                        <span class="game-item__opp-name">${escapeHtml(game.opponent)}</span>
                        <span class="game-item__meta">${isHome ? "Home" : "Away"}${game.time ? ` \u2022 ${escapeHtml(game.time)}` : ""}</span>
                    </div>
                    <span class="game-item__opp-record">${escapeHtml(game.opponentRecord || "??")}</span>
                </div>
            `;
                })
                .join("");
        }

        modal?.showModal();
    });

    closeBtn?.addEventListener("click", () => {
        closeModal();
    });

    modal?.addEventListener("click", (e) => {
        if (e.target === modal) {
            closeModal();
        }
    });

    function closeModal() {
        if (!modal) return;
        modal.classList.add("modal--closing");
        modal.addEventListener(
            "animationend",
            () => {
                modal.classList.remove("modal--closing");
                modal.close();
            },
            { once: true },
        );
    }
</script>
