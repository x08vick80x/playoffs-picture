---
---

<dialog id="schedule-modal" class="modal">
    <div class="modal__content">
        <header class="modal__header">
            <svg id="modal-team-logo" class="modal__logo" width="56" height="56">
                <use href="/sprites.svg#nfl"></use>
            </svg>
            <div class="modal__heading">
                <span class="modal__eyebrow">Remaining schedule</span>
                <h2 id="modal-team-name" class="modal__title">Team Name</h2>
                <span id="modal-games-left" class="modal__count"></span>
            </div>
            <button id="close-modal" class="modal__close-btn" aria-label="Close">&times;</button>
        </header>

        <div class="modal__list" id="schedule-list">
            <!-- Populated via JS -->
        </div>
    </div>
</dialog>
