---
import type { ScheduleWeek } from "@/types/football.ts";
import SectionTitle from "@/components/atoms/SectionTitle/SectionTitle.astro";
import ScheduleRow from "@/components/molecules/ScheduleRow/ScheduleRow.astro";
import { getScheduleWeekNumber } from "@scraper/config.ts";



type Week = ScheduleWeek;

interface Props {
    weeks: Week[];
}

const { weeks } = Astro.props;

const weekLabel = (id: string) => `Week ${id.replace("REG", "")}`;
const defaultWeekId = `REG${getScheduleWeekNumber()}`;
const initialWeek = weeks.find((week) => week.week === defaultWeekId) || weeks[0];
---

<div class="season-schedule">
    <SectionTitle title="Season Schedule" />

    <div class="season-schedule__tabs" id="week-tabs" aria-label="Schedule weeks">
        {weeks.map((week) => (
            <button
                type="button"
                class:list={["season-schedule__tab", { "season-schedule__tab--active": week.week === initialWeek?.week }]}
                data-week={week.week}
                data-url={`/schedule/${week.week}`}
                aria-controls="schedule-week"
                aria-pressed={week.week === initialWeek?.week ? "true" : "false"}
            >
                {weekLabel(week.week)}
            </button>
        ))}
    </div>

    <div class="season-schedule__status" hidden>
        <p role="status" aria-live="polite" data-schedule-status></p>
        <button type="button" class="season-schedule__retry" hidden>Retry</button>
    </div>
    <div id="schedule-week" aria-busy="false">
        {initialWeek && (
            <div class="season-schedule__panel" data-week-panel={initialWeek.week} aria-label={weekLabel(initialWeek.week)}>
                {initialWeek.matches.length === 0 && (
                    <div class="season-schedule__empty">- No matchups available -</div>
                )}
                {initialWeek.matches.map((match) => <ScheduleRow match={match} />)}
            </div>
        )}
    </div>
</div>
