---
import { pwaInfo } from "virtual:pwa-info";
import { initializeAppearance } from "@/scripts/bootstrap.ts";
import Analytics from "@vercel/analytics/astro";
import { dataVersion } from "@/utils/data-version";
import Toast from "@/components/atoms/Toast/Toast.astro";

interface Props {
    title: string;
}

const { title } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="data-version" content={dataVersion} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/favicon.svg" />
        <meta name="theme-color" content="#252525" />
        <script is:inline set:html={`(${initializeAppearance.toString()})();`} />
        <meta name="generator" content={Astro.generator} />

        <!-- Primary Meta Tags -->
        <title>{title}</title>
        <link rel="canonical" href={canonicalURL} />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta name="title" content={title} />
        <meta
            name="description"
            content="Updated NFL Playoff Picture 2026. Current standings, seeds, and matchups for AFC and NFC. Fast, offline-ready."
        />
        <meta
            name="keywords"
            content="NFL, Playoff, Standings, 2026, AFC, NFC, Bracket, Football"
        />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta
            property="og:description"
            content="Updated NFL Playoff Picture 2026. Current standings, seeds, and matchups for AFC and NFC. Fast, offline-ready."
        />
        <meta property="og:image" content="/logo.svg" />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={title} />
        <meta
            property="twitter:description"
            content="Updated NFL Playoff Picture 2026. Current standings, seeds, and matchups for AFC and NFC. Fast, offline-ready."
        />
        <meta property="twitter:image" content="/logo.svg" />

        {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}

        <style is:global lang="scss">
            @use "@/styles/main.scss";
        </style>
    </head>
    <body>
        <slot />
        <Toast />
        <Analytics />
        <script src="@/pwa.ts"></script>
        <script src="@/scripts/install-prompt.ts"></script>
    </body>
</html>
